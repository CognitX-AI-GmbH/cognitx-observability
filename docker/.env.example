# Observability Stack Credentials
# Copy to .env and set real values before first run:
#   cp .env.example .env
#   # Edit .env with your passwords

# Phoenix PostgreSQL
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=CHANGE_ME
PHOENIX_DB_NAME=phoenix

# Phoenix ports
PHOENIX_UI_PORT=6006
PHOENIX_OTLP_PORT=4317

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3001

# Alert delivery (Alertmanager -> email). Dev default: the cognitx-lite
# mailpit (SMTP 127.0.0.1:1125, UI http://127.0.0.1:8125). Production:
# a real SMTP relay with TLS and credentials.
ALERT_EMAIL_TO=oncall@cognitx.local
ALERT_EMAIL_FROM=alertmanager@cognitx.local
ALERT_SMTP_SMARTHOST=host.docker.internal:1125
ALERT_SMTP_AUTH_USERNAME=
ALERT_SMTP_AUTH_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=false
ALERTMANAGER_PORT=9093

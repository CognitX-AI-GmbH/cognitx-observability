# Alertmanager configuration TEMPLATE. render.sh fills the ${ALERT_*}
# placeholders from the environment (docker/.env) at container start;
# Alertmanager itself does not expand environment variables.
global:
  resolve_timeout: 5m
  smtp_smarthost: "${ALERT_SMTP_SMARTHOST}"
  smtp_from: "${ALERT_EMAIL_FROM}"
  smtp_auth_username: "${ALERT_SMTP_AUTH_USERNAME}"
  smtp_auth_password: "${ALERT_SMTP_AUTH_PASSWORD}"
  smtp_require_tls: ${ALERT_SMTP_REQUIRE_TLS}
  smtp_hello: "cognitx-alertmanager"

route:
  receiver: email
  group_by: ["alertname", "service", "job"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # The synthetic pipeline test (make alert-test): deliver at once.
    - matchers: ['alertname="AlertPipelineTest"']
      receiver: email
      group_wait: 0s
      repeat_interval: 1h
    # Informational alerts are for dashboards, not for mailboxes.
    - matchers: ['severity="info"']
      receiver: "null"
    - matchers: ['severity="critical"']
      receiver: email
      repeat_interval: 1h

inhibit_rules:
  # A dead target explains every alert from the same job.
  - source_matchers: ['alertname="ServiceDown"']
    target_matchers: ['alertname!="ServiceDown"']
    equal: ["job"]

receivers:
  - name: email
    email_configs:
      - to: "${ALERT_EMAIL_TO}"
        send_resolved: true
  - name: "null"

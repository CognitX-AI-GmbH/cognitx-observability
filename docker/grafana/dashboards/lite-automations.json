        }
      },
      "targets": [
        {
          "expr": "sum(increase(cognitx_automation_envelope_fires_total{job=\"intelligence\"}[1h])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "description": "An envelope fire is a consented action leaving the system inside its agreed bounds."

    {
      "type": "timeseries",
      "title": "Start lag p95 and orphan recoveries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cognitx_bg_job_start_lag_seconds_bucket{job=\"intelligence\"}[5m])) by (le))",
          "legendFormat": "start lag p95",
          "refId": "A"
        },
        {
          "expr": "sum(increase(cognitx_bg_jobs_orphan_recovered_total{job=\"intelligence\"}[1h]))",
          "legendFormat": "orphans recovered / h",
